# Обязательно в production: секрет для подписи кодов и токенов подписки (минимум 16 символов).
# Сгенерировать: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
APP_SECRET=

# Порт и папка для базы (коды подписки, счётчики, статистика событий).
PORT=8080
DATA_DIR=./data
# 1 — если приложение стоит за прокси (Render, Railway, nginx) и нужен настоящий IP из X-Forwarded-For.
TRUST_PROXY=1

# ИИ-поддержка. Без ключа чат выключен, остальное приложение работает.
ANTHROPIC_API_KEY=
# Модель по умолчанию — claude-opus-5. Дешевле: claude-sonnet-5 или claude-haiku-4-5
# (для claude-haiku-4-5 поставьте AI_EFFORT= и AI_FALLBACKS=0).
AI_MODEL=claude-opus-5
AI_EFFORT=low
AI_FALLBACKS=1
AI_MAX_TOKENS=4000
# Сообщений ИИ в день: бесплатно и с подпиской «Плюс».
FREE_AI_PER_DAY=5
PREMIUM_AI_PER_DAY=200
# 1 — тестовый режим без обращения к API (для разработки и демо).
AI_MOCK=0

# Цены «Плюса» (в сомах и тенге) — показываются в приложении.
PRICE_KG_1=390
PRICE_KG_3=990
PRICE_KG_12=2990
PRICE_KZ_1=1990
PRICE_KZ_3=4990
PRICE_KZ_12=14990

# Куда платить и куда прислать чек. Пока не заполнено, в приложении написано «Оплата появится в ближайшее время».
PAY_KG_PHONE=
PAY_KG_CONTACT=
PAY_KZ_PHONE=
PAY_KZ_CONTACT=

# Токен для GET /api/admin/stats (статистика воронки).
ADMIN_TOKEN=
